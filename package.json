{
  "name": "memorymesh",
  "version": "0.4.0",
  "description": "An MCP server that uses a knowledge graph to store and recall structured memory for AI models",
  "license": "MIT",
  "author": "CheMiguel23",
  "homepage": "https://github.com/CheMiguel23/memorymesh",
  "bugs": "https://github.com/CheMiguel23/memorymesh/issues",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memorymesh": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-schemas.mjs",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
